# 生产环境默认 https://museumapi.ottozhang.com
# 本地开发可改为 http://127.0.0.1:8000
EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=577788424612-d3gutf0ru81i1tdrfdm5m21c27rvp27k.apps.googleusercontent.com
# Android 需要应用类型为 Web application 的 OAuth Client ID，不能填 Android Client ID；
# 后端 GOOGLE_CLIENT_ID 也应使用同一个 Web application Client ID。
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=577788424612-mtu5sal27kunufruqrduv4jnpivc5ipq.apps.googleusercontent.com

# 是否使用假的识别接口，仅用于前端 UI 测试。
# true  时 analyzeImage 不会调用后端，而是返回内置的示例讲解文案。
# false 时正常调用后端 /analyze 接口。
EXPO_PUBLIC_USE_FAKE_ANALYZE=false
